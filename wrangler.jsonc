{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "supporthub",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
